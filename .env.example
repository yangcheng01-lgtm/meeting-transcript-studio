# Copy to .env only for local development; never commit .env.
FFMPEG_PATH=C:\path\to\ffmpeg.exe
VOICEID_PYTHON=C:\path\to\voiceid-python.exe
ASR_CONFIG_PATH=C:\path\to\asr.json
ASR_API_URL=https://ai-service.segway-ninebot.com/v1/audio/transcriptions
ASR_API_KEY=
MINUTES_SKILL_PATH=skills/meeting-minutes-synthesis-zh/SKILL.md
# Keep runtime projects and uploaded media outside the source repository when C: is tight.
MEETING_DATA_ROOT=D:\多听工作台
MEETING_PROJECTS_DIR=D:\多听工作台\data\projects
HF_HOME=D:\多听工作台\model-cache\huggingface
TORCH_HOME=D:\多听工作台\model-cache\torch
PYANNOTE_CACHE=D:\多听工作台\model-cache\torch\pyannote

# Low-multiplier external model for report generation
DEFAULT_LLM_MODEL=external/glm-5.3-flash
# Optional fallback when the app Python does not contain yt-dlp
YTDLP_PYTHON=C:\path\to\python.exe
YTDLP_PROXY=http://127.0.0.1:7897
